{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "agent": {
    "ask": {
      "description": "Answers questions without making changes",
      "prompt": "{file:./prompts/ask.txt}",
      "permissions": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "external_directory": "ask",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "skill": "allow",
        "question": "allow"
      }
    },
    "review": {
      "description": "Answers questions without making changes",
      "prompt": "{file:./prompts/review.txt}",
      "permissions": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "external_directory": "ask",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "deny",
        "skill": "allow",
        "question": "allow"
      }
    }
  }
}
