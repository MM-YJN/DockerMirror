{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning",
      "System.Net.Http": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mirror": {
    "BasePath": null,
    "Upstream": {
      "RegistryUrl": "https://registry-1.docker.io",
      "TokenRealm": "https://auth.docker.io/token",
      "TokenService": "registry.docker.io",
      "DefaultNamespace": "library",
      "TokenCacheTtl": "00:05:00",
      "Auth": null,
      "Proxy": {
        "Url": null,
        "Registry": null,
        "Auth": null,
        "Cdn": null
      },
      "Resilience": {
        "Enabled": true,
        "MaxRetryAttempts": 3,
        "BaseDelay": "00:00:01",
        "AttemptTimeout": "00:00:10",
        "TotalRequestTimeout": "00:00:30",
        "HeadersTimeout": "00:00:30",
        "FailureRatio": 0.1,
        "SamplingDuration": "00:00:30",
        "MinimumThroughput": 10,
        "BreakDuration": "00:00:15",
        "ConnectTimeout": "00:00:10"
      }
    },
    "Cache": {
      "Enabled": false,
      "Backend": "FileSystem",
      "FileSystem": {
        "Directory": "docker-mirror-cache"
      },
      "S3": {
        "Bucket": "",
        "Region": "us-east-1",
        "ServiceUrl": null,
        "AccessKey": "",
        "SecretKey": "",
        "KeyPrefix": "",
        "UsePathStyle": false
      },
      "WarmQueueCapacity": 256,
      "TagManifests": {
        "Enabled": true,
        "Ttl": "00:05:00"
      },
      "Eviction": {
        "Enabled": true,
        "Strategy": "Oldest",
        "MaxSizeBytes": null,
        "MaxAge": null,
        "Interval": "00:15:00",
        "TargetUtilization": 0.9
      },
      "SizeReporting": {
        "Enabled": false,
        "Interval": "00:05:00"
      },
      "NegativeCache": {
        "Enabled": true,
        "Ttl": "00:01:00",
        "MaxEntries": 10000
      }
    },
    "Admin": {
      "Enabled": false,
      "Path": "/admin/stats"
    }
  }
}
